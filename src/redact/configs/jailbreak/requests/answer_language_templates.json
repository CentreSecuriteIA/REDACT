  "languages": [
    "French", "Japanese", "Russian", "Spanish", "German", "Arabic",
    "Turkish", "Czech", "Vietnamese", "Greek", "Croatian", "Thai",
    "Swahili", "Khmer", "Maori", "Nepali", "Zulu",
    "Scots Gaelic", "Bengali", "Javanese"
  ]
}
