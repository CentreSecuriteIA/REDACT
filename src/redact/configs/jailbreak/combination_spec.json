{
  "_comment": "Jailbreak technique compatibility specification. All rules enforced in jailbreak/rules.py. kinds, on a family or a technique, lists the augmentation kinds that may draw it: absent is [\"adversarial\"], and a technique's own kinds replace its first family's. since and deprecated, on a technique, are the versions that added and retired it (absent since is \"1.0\"): version moves up, as dotted whole numbers (\"1.9\", \"1.10\"), in each change that adds or retires a technique, and the technique carries the new version. within_layer_order, on an obfuscation family, is the order the layer's families apply in, numbered in tens so a family added later slots in between: the whole-text rewrites first (translation 10, typos 20, casual_writing 30, noise 35), so they cannot undo a word-level step, then the word-level steps (sensitive_words 40, tokenbreak 50), suffixes 60, encode 70, structural and neutral_container 80 (they exclude each other, so they never meet) and ascii_art 90, the outermost. A technique takes its first family's. check and calls, on a family or a technique (a technique's own replacing its first family's), declare what checks a model-written technique's reply (typos, scenario, word_list or translate) and the model calls one application makes, generation and checks, as a whole number or [low, high]; nothing changes the draw by them. A translation's calls are for a one-paragraph prompt: a chat translator makes 2 to 8, a machine translation 3 to 12 (2P + 1 a round for P pieces). A cognitive or persona technique makes 3 to 9: a scenario (up to 3 replies for one with a scene), its check, again once when rejected, then the construction. Read by jailbreak/technique.py (tag) and jailbreak/pool.py.",

  "version": "1.2",

  "layer_order": ["rewrite", "hacking", "manipulation", "obfuscation", "requests"],

  "layer_rates": {
    "_comment": "Per-layer target rates: the planner deals each layer at its rate over a group, and a direct sample_combination() call reads them as per-unit inclusion probabilities. Overridable per-call via the sampling_probs argument. rewrite, the first layer, holds no technique yet; its rate is 0, and both packaged kinds deny it (augmentations.json).",
    "rewrite": 0,
    "hacking": 0.5,
    "manipulation": 0.33,
    "requests": 0.7,
    "request_obfuscation": 0.5
  },

  "layer_max_picks": {
    "rewrite": 1,
    "hacking": 1,
    "manipulation": 1,
    "requests": 1
  },

  "families": {
    "sensitive_words": {
      "description": "Selective obfuscation of detected harmful words (char substitution, encoding, or synonym)",
      "layer": "obfuscation",
      "dimension": "encoding",
      "within_layer_order": 40,
      "check": "word_list",
      "calls": 1,
      "cross_incompatible_with": []
    },
    "tokenbreak": {
      "description": "Token-level splitting/prepending attacks targeting harmful words",
      "layer": "obfuscation",
      "dimension": "encoding",
      "within_layer_order": 50,
      "check": "word_list",
      "calls": 1,
      "cross_incompatible_with": []
    },
    "translation": {
      "description": "Full-text translation to a low/mid/high-resource language",
      "layer": "obfuscation",
      "dimension": "language",
      "kinds": ["adversarial", "natural"],
      "within_layer_order": 10,
      "check": "translate",
      "calls": [2, 12],
      "cross_incompatible_with": ["ascii_art"]
    },
    "typos": {
      "description": "LLM-rewritten prompt with varying typo density",
      "layer": "obfuscation",
      "dimension": "surface_noise",
      "kinds": ["adversarial", "natural"],
      "within_layer_order": 20,
      "check": "typos",
      "calls": [2, 4],
      "cross_incompatible_with": []
    },
    "suffixes": {
      "description": "Adversarial suffix appended to the prompt",
      "layer": "obfuscation",
      "dimension": "surface_noise",
      "within_layer_order": 60,
      "cross_incompatible_with": []
    },
    "encode": {
      "description": "Full-text encoding/cyphering (base64, rot*, leetspeak, morse, braille, etc.)",
      "layer": "obfuscation",
      "dimension": "encoding",
      "within_layer_order": 70,
      "cross_incompatible_with": []
    },
    "structural": {
      "description": "JSON/XML/Markdown structural wrapping as outer frame",
      "layer": "obfuscation",
      "dimension": "container",
      "within_layer_order": 80,
      "cross_incompatible_with": ["ascii_art"]
    },
    "neutral_container": {
      "description": "The prompt placed in an everyday document: a code comment, a YAML document, a CSV row, an email, a transcript line or a log entry",
      "layer": "obfuscation",
      "dimension": "container",
      "kinds": ["adversarial", "natural"],
      "within_layer_order": 80,
      "cross_incompatible_with": ["structural", "ascii_art"]
    },
    "ascii_art": {
      "description": "Full-text ASCII art conversion (outermost, incompatible with structural and hacking/manipulation due to output size)",
      "layer": "obfuscation",
      "dimension": "encoding",
      "within_layer_order": 90,
      "cross_incompatible_with": ["structural", "translation", "framing", "persona", "cognitive", "fsh", "dap"]
    },
    "casual_writing": {
      "description": "Casing, spacing, punctuation, abbreviations or accents as a person typing quickly writes them",
      "layer": "obfuscation",
      "dimension": "surface_noise",
      "kinds": ["adversarial", "natural"],
      "within_layer_order": 30,
      "cross_incompatible_with": []
    },
    "noise": {
      "description": "Random capitals, scrambled letters, keyboard typos or emoji between words, at three densities",
      "layer": "obfuscation",
      "dimension": "surface_noise",
      "kinds": ["adversarial", "natural"],
      "within_layer_order": 35,
      "cross_incompatible_with": ["typos", "casual_writing"]
    },
    "framing": {
      "description": "Scenario/context modifiers: fictional world, noble/nefarious goal, urgency, constraint removal",
      "layer": "hacking",
      "dimension": "role_framing",
      "within_layer_order": 0,
      "cross_incompatible_with": ["fsh", "dap"]
    },
    "persona": {
      "description": "Named or invented persona roleplay archetypes",
      "layer": "hacking",
      "dimension": "role_framing",
      "within_layer_order": 0,
      "check": "scenario",
      "calls": [3, 9],
      "cross_incompatible_with": ["fsh", "dap", "impersonation"]
    },
    "cognitive": {
      "description": "Two-step cognitive/psychological jailbreak construction",
      "layer": "hacking",
      "dimension": "role_framing",
      "within_layer_order": 0,
      "check": "scenario",
      "calls": [3, 9],
      "cross_incompatible_with": ["fsh", "dap", "impersonation"]
    },
    "fsh": {
      "description": "Few-Shot Hacking: benign Q&A pairs before harmful question",
      "layer": "manipulation",
      "dimension": "example_priming",
      "within_layer_order": 0,
      "cross_incompatible_with": ["continuation", "indirect", "framing", "persona", "cognitive"]
    },
    "dap": {
      "description": "Distract and Persuade: harmful question hidden in middle of benign Q&A pairs",
      "layer": "manipulation",
      "dimension": "example_priming",
      "within_layer_order": 0,
      "cross_incompatible_with": ["continuation", "indirect", "framing", "persona", "cognitive"]
    },
    "answer_format": {
      "description": "Output-format and response-conditioning directives",
      "layer": "requests",
      "dimension": "answer_shape",
      "kinds": ["adversarial", "natural"],
      "within_layer_order": 0,
      "cross_incompatible_with": []
    },
    "answer_language": {
      "description": "Ask for the response in a specific language",
      "layer": "requests",
      "dimension": "language",
      "kinds": ["adversarial", "natural"],
      "within_layer_order": 0,
      "cross_incompatible_with": []
    },
    "continuation": {
      "description": "Frame the prompt as incomplete content to continue",
      "layer": "requests",
      "dimension": "request_shape",
      "within_layer_order": 0,
      "cross_incompatible_with": ["fsh", "dap"]
    },
    "indirect": {
      "description": "Embed harmful request inside a legitimate task (summarize, proofread, etc.)",
      "layer": "requests",
      "dimension": "request_shape",
      "kinds": ["adversarial", "natural"],
      "within_layer_order": 0,
      "cross_incompatible_with": ["fsh", "dap"]
    },
    "distractor_prefix": {
      "description": "Add noise before the prompt to distract classifiers",
      "layer": "requests",
      "dimension": "request_shape",
      "within_layer_order": 0,
      "cross_incompatible_with": []
    },
    "distractor_suffix": {
      "description": "Add noise after the prompt to distract classifiers",
      "layer": "requests",
      "dimension": "request_shape",
      "within_layer_order": 0,
      "cross_incompatible_with": []
    },
    "impersonation": {
      "description": "Claim a trustworthy professional identity",
      "layer": "requests",
      "dimension": "role_framing",
      "within_layer_order": 0,
      "cross_incompatible_with": []
    },
    "temporal": {
      "description": "Reframe the request as a past/historical event",
      "layer": "requests",
      "dimension": "request_shape",
      "within_layer_order": 0,
      "cross_incompatible_with": []
    },
    "asking": {
      "description": "Innocuous framing or detail-maximising directives",
