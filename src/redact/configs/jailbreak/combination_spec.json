{
  "_comment": "Jailbreak technique compatibility specification. All rules enforced by get_compatible_remaining() in jailbreak/utils.py.",

  "version": "1.0",

  "layer_order": ["hacking", "manipulation", "obfuscation", "requests"],

  "sampling_probs": {
    "_comment": "Per-layer inclusion probabilities used by sample_combination(). Overridable per-call via the sampling_probs argument.",
    "hacking": 0.5,
    "manipulation": 0.33,
    "requests": 0.7,
    "request_obfuscation": 0.5
  },

  "layer_max_picks": {
    "hacking": 1,
    "manipulation": 1,
    "requests": 1
  },

  "families": {
    "sensitive_words": {
      "description": "Selective obfuscation of detected harmful words (char substitution, encoding, or synonym)",
      "layer": "obfuscation",
      "within_layer_order": 1,
      "max_picks": 1,
      "cross_incompatible_with": []
    },
    "tokenbreak": {
      "description": "Token-level splitting/prepending attacks targeting harmful words",
      "layer": "obfuscation",
      "within_layer_order": 2,
      "max_picks": 1,
      "cross_incompatible_with": []
    },
    "translation": {
      "description": "Full-text translation to a low/mid/high-resource language",
      "layer": "obfuscation",
      "within_layer_order": 3,
      "max_picks": 1,
      "cross_incompatible_with": []
    },
    "typos": {
      "description": "LLM-rewritten prompt with varying typo density",
      "layer": "obfuscation",
      "within_layer_order": 4,
      "max_picks": 1,
      "cross_incompatible_with": []
    },
    "suffixes": {
      "description": "Adversarial suffix appended to the prompt",
      "layer": "obfuscation",
      "within_layer_order": 5,
      "max_picks": 1,
      "cross_incompatible_with": []
    },
    "encode": {
      "description": "Full-text encoding/cyphering (base64, rot*, leetspeak, morse, braille, etc.)",
      "layer": "obfuscation",
      "within_layer_order": 6,
      "max_picks": 1,
      "cross_incompatible_with": []
    },
    "structural": {
      "description": "JSON/XML/Markdown structural wrapping as outer frame",
      "layer": "obfuscation",
      "within_layer_order": 7,
      "max_picks": 1,
      "cross_incompatible_with": ["ascii_art"]
    },
    "ascii_art": {
      "description": "Full-text ASCII art conversion (outermost, incompatible with structural and hacking/manipulation due to output size)",
      "layer": "obfuscation",
      "within_layer_order": 8,
      "max_picks": 1,
      "cross_incompatible_with": ["structural", "framing", "persona", "cognitive", "fsh", "dap"]
    },
    "framing": {
      "description": "Scenario/context modifiers: fictional world, noble/nefarious goal, urgency, constraint removal",
      "layer": "hacking",
      "within_layer_order": 0,
      "max_picks": 1,
      "cross_incompatible_with": ["fsh", "dap"]
    },
    "persona": {
      "description": "Named or invented persona roleplay archetypes",
      "layer": "hacking",
      "within_layer_order": 0,
      "max_picks": 1,
      "cross_incompatible_with": ["fsh", "dap"]
    },
    "cognitive": {
      "description": "Two-step cognitive/psychological jailbreak construction",
      "layer": "hacking",
      "within_layer_order": 0,
      "max_picks": 1,
      "cross_incompatible_with": ["fsh", "dap"]
    },
    "fsh": {
      "description": "Few-Shot Hacking: benign Q&A pairs before harmful question",
      "layer": "manipulation",
      "within_layer_order": 0,
      "max_picks": 1,
      "cross_incompatible_with": ["continuation", "indirect", "framing", "persona", "cognitive"]
    },
    "dap": {
      "description": "Distract and Persuade: harmful question hidden in middle of benign Q&A pairs",
      "layer": "manipulation",
      "within_layer_order": 0,
      "max_picks": 1,
      "cross_incompatible_with": ["continuation", "indirect", "framing", "persona", "cognitive"]
    },
    "answer_format": {
      "description": "Output-format and response-conditioning directives",
      "layer": "requests",
      "within_layer_order": 0,
      "max_picks": 1,
      "cross_incompatible_with": []
    },
    "answer_language": {
      "description": "Ask for the response in a specific language",
      "layer": "requests",
      "within_layer_order": 0,
      "max_picks": 1,
      "cross_incompatible_with": []
    },
    "continuation": {
      "description": "Frame the prompt as incomplete content to continue",
      "layer": "requests",
      "within_layer_order": 0,
      "max_picks": 1,
      "cross_incompatible_with": ["indirect", "fsh", "dap"]
    },
    "indirect": {
      "description": "Embed harmful request inside a legitimate task (summarize, proofread, etc.)",
      "layer": "requests",
      "within_layer_order": 0,
      "max_picks": 1,
      "cross_incompatible_with": ["continuation", "fsh", "dap"]
    },
    "distractor_prefix": {
      "description": "Add noise before the prompt to distract classifiers",
      "layer": "requests",
      "within_layer_order": 0,
      "max_picks": 1,
      "cross_incompatible_with": []
    },
    "distractor_suffix": {
      "description": "Add noise after the prompt to distract classifiers",
      "layer": "requests",
      "within_layer_order": 0,
      "max_picks": 1,
      "cross_incompatible_with": []
    },
    "impersonation": {
      "description": "Claim a trustworthy professional identity",
      "layer": "requests",
      "within_layer_order": 0,
      "max_picks": 1,
      "cross_incompatible_with": []
    },
    "temporal": {
      "description": "Reframe the request as a past/historical event",
      "layer": "requests",
      "within_layer_order": 0,
      "max_picks": 1,
      "cross_incompatible_with": []
    },
    "asking": {
      "description": "Innocuous framing or detail-maximising directives",
      "layer": "requests",
      "within_layer_order": 0,
      "max_picks": 1,
      "cross_incompatible_with": []
    }
  },

  "manipulation_blocked_obfuscation": {
    "_comment": "When manipulation (fsh/dap) is selected, block these obfuscation families and encode_weight values (except when encode also has sensitive_words family — selective encoding is still fine)",
    "families": ["ascii_art", "translation"],
    "encode_weight": "heavy"
  },

  "request_obfuscation_allowed_families": ["encode_light", "translation"],

  "techniques": {
    "_comment": "encode_weight applies only to encode-family members. 'light' = model-readable after decoding; 'heavy' = opaque, blocked when manipulation is selected unless function also has sensitive_words family.",

