  "manipulation_blocked_obfuscation": {
    "_comment": "When manipulation (fsh/dap) is selected, block these obfuscation families and encode_weight values (except when encode also has sensitive_words family — selective encoding is still fine)",
    "families": ["ascii_art", "translation"],
    "encode_weight": "heavy"
  },

  "request_obfuscation_allowed_families": ["encode_light", "translation"],

  "generators": {
    "_comment": "Families whose techniques come one per row of a data file beside this spec. jailbreak/technique.py (read_spec) expands each into technique entries, so every reader sees them under techniques: a row (of file, and with where only one whose column of that name is true) makes the technique name, {slug} its slug, with families [the key], this entry's other keys, and the row's complexity, since and deprecated over them. The family's module builds the functions from the same file, so adding a row adds the technique; import fails while the two disagree.",
    "translation":     { "file": "languages.json", "where": "translation", "name": "to_{slug}", "requires_llm": true },
    "answer_language": { "file": "languages.json", "where": "answer_language", "name": "to_ask_answer_in_{slug}", "requires_llm": false }
  },

  "techniques": {
